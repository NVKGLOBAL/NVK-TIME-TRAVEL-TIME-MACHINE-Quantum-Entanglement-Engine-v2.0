# =====================================================================
# NVK TIME MACHINE - UNIVERSAL AI ENGINE CONFIGURATION (.env.example)
# =====================================================================
# You can swap AI models in 2 ways:
# 1. Directly in the UI via the "SWAP MODEL" / "AI ENGINE" button in the header or AI Core tab.
# 2. Or by setting default environment variables below before building/running.

# ---------------------------------------------------------------------
# PRIMARY AI PROVIDER SELECTION
# Supported options: gemini | openai | anthropic | deepseek | groq | ollama | custom
# ---------------------------------------------------------------------
VITE_AI_PROVIDER=gemini

# ---------------------------------------------------------------------
# MODEL NAME / ID
# Examples by Provider:
# - Gemini:    gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash
# - OpenAI:    gpt-4o, gpt-4o-mini, o3-mini
# - DeepSeek:  deepseek-chat, deepseek-reasoner
# - Groq:      llama-3.3-70b-versatile, mixtral-8x7b-32768
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# - Ollama:    llama3.2, deepseek-r1:8b, mistral
# ---------------------------------------------------------------------
VITE_AI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------
# API KEYS (Fill in the key for your active provider)
# ---------------------------------------------------------------------
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
VITE_OPENAI_API_KEY=

# Anthropic API Key
VITE_ANTHROPIC_API_KEY=

# DeepSeek API Key
VITE_DEEPSEEK_API_KEY=

# Groq API Key
VITE_GROQ_API_KEY=

# ---------------------------------------------------------------------
# BASE ENDPOINT URL (Optional / Customizable)
# Default for Gemini: https://generativelanguage.googleapis.com/v1beta
# Default for OpenAI: https://api.openai.com/v1
# Default for DeepSeek: https://api.deepseek.com/v1
# Default for Groq: https://api.groq.com/openai/v1
# Default for Ollama: http://localhost:11434/v1
# OpenRouter / Custom: https://openrouter.ai/api/v1
# ---------------------------------------------------------------------
VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
